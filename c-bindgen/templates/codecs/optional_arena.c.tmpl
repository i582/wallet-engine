WALLET_ENGINE_PRIVATE WalletEngineAbiStatus wallet_engine_private_write_{{FUNCTION_NAME}}(
    WalletEnginePrivateBufferWriter *writer,
    {{C_NAME}} value
) {
    WalletEngineAbiStatus status = wallet_engine_private_write_u8(
        writer,
        value.has_value ? 1u : 0u
    );
    if (status != WALLET_ENGINE_ABI_STATUS_OK || !value.has_value) {
        return status;
    }
    return wallet_engine_private_write_{{INNER_FUNCTION_NAME}}(writer, value.value);
}

WALLET_ENGINE_PRIVATE WalletEngineAbiStatus wallet_engine_private_read_{{FUNCTION_NAME}}(
    WalletEnginePrivateBufferReader *reader,
    WalletEnginePrivateArena *arena,
    {{C_NAME}} *out_value
) {
    WalletEnginePrivateArenaBlock *mark;
    uint8_t tag = 0u;
    WalletEngineAbiStatus status;
    if (reader == NULL || arena == NULL || out_value == NULL) {
        return WALLET_ENGINE_ABI_STATUS_INVALID_ARGUMENT;
    }
    *out_value = ({{C_NAME}}){0};
    mark = arena->head;
    status = wallet_engine_private_read_u8(reader, &tag);
    if (status != WALLET_ENGINE_ABI_STATUS_OK) {
        return status;
    }
    switch (tag) {
        case 0u:
            return WALLET_ENGINE_ABI_STATUS_OK;
        case 1u:
            status = wallet_engine_private_read_{{INNER_FUNCTION_NAME}}(
                reader,
                arena,
                &out_value->value
            );
            if (status == WALLET_ENGINE_ABI_STATUS_OK) {
                out_value->has_value = true;
            } else {
                wallet_engine_private_arena_rewind(arena, mark);
            }
            return status;
        default:
            wallet_engine_private_arena_rewind(arena, mark);
            return WALLET_ENGINE_ABI_STATUS_INVALID_ARGUMENT;
    }
}

WALLET_ENGINE_PRIVATE WalletEngineAbiStatus wallet_engine_private_lower_{{FUNCTION_NAME}}(
    {{C_NAME}} value,
    WalletEnginePrivateRustBuffer *out_buffer
) {
    size_t wire_size = 0u;
    WalletEnginePrivateBufferWriter writer;
    WalletEngineAbiStatus status = wallet_engine_private_measure_{{FUNCTION_NAME}}(
        value,
        &wire_size
    );
    if (status != WALLET_ENGINE_ABI_STATUS_OK) {
        return status;
    }
    status = wallet_engine_private_rustbuffer_alloc(wire_size, out_buffer);
    if (status != WALLET_ENGINE_ABI_STATUS_OK) {
        return status;
    }
    writer = (WalletEnginePrivateBufferWriter){out_buffer->data, wire_size, 0u};
    status = wallet_engine_private_write_{{FUNCTION_NAME}}(&writer, value);
    if (status != WALLET_ENGINE_ABI_STATUS_OK) {
        wallet_engine_private_rustbuffer_free(*out_buffer);
        *out_buffer = (WalletEnginePrivateRustBuffer){0};
    }
    return status;
}

WALLET_ENGINE_PRIVATE WalletEngineAbiStatus wallet_engine_private_lift_{{FUNCTION_NAME}}(
    const WalletEnginePrivateRustBuffer *buffer,
    WalletEnginePrivateArena *arena,
    {{C_NAME}} *out_value
) {
    WalletEnginePrivateArenaBlock *mark;
    WalletEnginePrivateBufferReader reader;
    WalletEngineAbiStatus status;
    if (arena == NULL || out_value == NULL
        || !wallet_engine_private_rustbuffer_is_valid(buffer)) {
        return WALLET_ENGINE_ABI_STATUS_PANIC;
    }
    mark = arena->head;
    reader = (WalletEnginePrivateBufferReader){buffer->data, (size_t)buffer->len, 0u};
    status = wallet_engine_private_read_{{FUNCTION_NAME}}(&reader, arena, out_value);
    if (status != WALLET_ENGINE_ABI_STATUS_OK || reader.offset != reader.len) {
        wallet_engine_private_arena_rewind(arena, mark);
        *out_value = ({{C_NAME}}){0};
        return WALLET_ENGINE_ABI_STATUS_PANIC;
    }
    return WALLET_ENGINE_ABI_STATUS_OK;
}
