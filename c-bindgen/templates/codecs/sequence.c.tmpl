WALLET_ENGINE_PRIVATE WalletEngineAbiStatus wallet_engine_private_read_{{FUNCTION_NAME}}(
    WalletEnginePrivateBufferReader *reader,
    WalletEnginePrivateArena *arena,
    {{C_NAME}} *out_value
) {
