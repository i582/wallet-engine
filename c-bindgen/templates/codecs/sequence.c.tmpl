    writer = (WalletEnginePrivateBufferWriter){out_buffer->data, wire_size, 0u};
    status = wallet_engine_private_write_{{FUNCTION_NAME}}(&writer, value);
    if (status != WALLET_ENGINE_ABI_STATUS_OK) {
        wallet_engine_private_rustbuffer_free(*out_buffer);
