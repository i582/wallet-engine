    {{INNER_C_NAME}} *items = NULL;
    void *allocation = NULL;
    int32_t wire_len = 0;
    size_t len;
    size_t index;
    WalletEngineAbiStatus status;
    if (reader == NULL || arena == NULL || out_value == NULL) {
        return WALLET_ENGINE_ABI_STATUS_INVALID_ARGUMENT;
    }
    *out_value = ({{C_NAME}}){0};
    mark = arena->head;
    status = wallet_engine_private_read_i32(reader, &wire_len);
    if (status != WALLET_ENGINE_ABI_STATUS_OK || wire_len < 0) {
        return WALLET_ENGINE_ABI_STATUS_INVALID_ARGUMENT;
    }
