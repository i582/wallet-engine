
/*
 * A borrowed sequence of bytes.
 *
 * `data` may be NULL only when `len` is zero. The bytes remain owned by the
 * caller and must stay readable for the documented lifetime of the view.
 */
typedef struct WalletEngineBytesView {
    const uint8_t *data;
    size_t len;
} WalletEngineBytesView;
