    {
      "action": {
        "kind": "expect.screenshot",
        "name": "ton-connect-ten-message-review",
        "target": "dialog"
      },
      "phase": "then"
    },
    {
      "action": {
        "kind": "wallet.rejectRequest"
      },
      "phase": "when"
    },
    {
      "action": {
        "kind": "expect.dapp.transactionRejected"
      },
      "phase": "then"
    }
