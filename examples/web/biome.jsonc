{
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "e2e/**",
      "package.json",
      "playwright.config.ts",
      "src/**",
      "test/**",
      "vite.config.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "bracketSpacing": false
  },
  "javascript": {
    "globals": ["Bun"],
    "formatter": {
      "arrowParentheses": "asNeeded",
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "preset": "all",
      "source": {
        "preset": "all",
        "organizeImports": "off",
        "useSortedAttributes": "off",
        "useSortedInterfaceMembers": "off",
        "useSortedKeys": "off",
        "useSortedProperties": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "correctness": {
        "noNodejsModules": "off",
        "noSolidDestructuredProps": "off",
        "noUnresolvedImports": "off",
        "useImportExtensions": "off"
      },
      "performance": {
        "noBarrelFile": "off",
        "noJsxPropsBind": "off",
        "useSolidForComponent": "off"
      },
      "style": {
        "noDefaultExport": "off",
        "noHexColors": "off",
        "noInferrableTypes": "off",
        "noJsxLiterals": "off",
        "noImplicitBoolean": "off",
        "noMagicNumbers": "off",
        "noParameterProperties": "off",
        "noTernary": "off",
        "useBlockStatements": "off",
        "useConsistentTypeDefinitions": "off",
        "useExportsLast": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noConsole": "off",
        "noReactSpecificProps": "off",
        "noShadow": "off",
        "noUnnecessaryConditions": "off",
        "useAwait": "off"
      }
    }
  }
}
